# =============================================================================
# VisionCraft 环境变量示例
#
# 用法：复制为 .env，按需填写。.env 只用于本地运行，不要提交。
# 未设置任何 LIVE 开关时，系统不会发起任何真实付费调用——默认即为最安全状态。
#
# 标记说明：
#   [护栏]  费用与授权护栏，默认值已安全，改动前请读完注释
#   [必需]  真实调用某类 Provider 时必需
#   [可选]  有默认值，通常不用改
#   [遗留]  当前代码不读取，仅为历史兼容保留
# =============================================================================

# -----------------------------------------------------------------------------
# [可选] 数据目录
# -----------------------------------------------------------------------------
# 留空 -> backend/data（数据库 + 项目资产）。
# 用于让离线验收跑在隔离目录，避免测试创建/删除项目时污染工作数据。
# 注意：仅作为进程级环境变量生效，从 .env 加载的值不会生效（防止误配切换真实数据）。
VISIONCRAFT_DATA_DIR=

# -----------------------------------------------------------------------------
# [护栏] 真实调用授权开关（默认关闭）
# -----------------------------------------------------------------------------
# ★ 重要安全语义：VISIONCRAFT_ALLOW_LIVE_LLM=1 会同时打开文本、视觉、视频三扇门。
#   live_vision_authorized() 与 live_video_authorized() 的实现都是
#       "..._ALLOW_LIVE_XXX" == "1"  OR  live_llm_authorized()
#   因此只想开其中一扇时，请显式设置三个开关，不要使用 LLM 总开关。
#   下层仍有次数与预算护栏兜底，但授权门本身是连带的。
VISIONCRAFT_ALLOW_LIVE_LLM=0
VISIONCRAFT_ALLOW_LIVE_VISION=0
VISIONCRAFT_ALLOW_LIVE_VIDEO=0

# 单次闭环内的真实视频调用上限。默认 1；硬上限 5（更大的值会被截断为 5）。
VISIONCRAFT_LIVE_MAX_VIDEO_CALLS=1

# 单次闭环的费用上限（元）。默认 5.0。预计费用超限即 BLOCKED_BEFORE_CALL。
# 已知记账口径：文本最多 3 次 + 视觉最多 1 次（硬编码不可配），
# MiniMax H3 768P 按 0.50 元/秒、默认 4 秒估算，费用缓冲系数 1.30、美元汇率 7.5。
VISIONCRAFT_LIVE_BUDGET_CNY=5.0

# -----------------------------------------------------------------------------
# [可选] Provider 选择
# -----------------------------------------------------------------------------
VISIONCRAFT_IMAGE_PROVIDER=ark
VISIONCRAFT_VIDEO_PROVIDER=ark

# -----------------------------------------------------------------------------
# [可选] 媒体传输
# -----------------------------------------------------------------------------
# data_url：首帧以内联方式提交，本机开发足够。
# public_url：需先部署对象存储或公网资产服务，并填写下面的公网前缀。
VISIONCRAFT_MEDIA_TRANSFER_MODE=data_url
VISIONCRAFT_MEDIA_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# [可选] FFmpeg 定位
# -----------------------------------------------------------------------------
# 留空时的查找顺序：系统 PATH -> 本变量 -> <仓库上级>/.tools/ffmpeg/bin -> <仓库上级>/.tools/ffmpeg
VISIONCRAFT_FFMPEG_DIR=

# -----------------------------------------------------------------------------
# [必需] 文本与视觉：DeepSeek
# -----------------------------------------------------------------------------
# 真实调用路径实际使用的模型由代码内的计费计划固定为：
#   文本 deepseek-v4-flash（max_tokens 4096，thinking disabled）
#   视觉 deepseek-v4-flash-vision-exp（max_tokens 2048，thinking disabled）
# DEEPSEEK_MODEL 供非计费路径的通用调用使用。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# -----------------------------------------------------------------------------
# [必需] 视频：MiniMax（V1 真实 2 镜验收使用此家）
# -----------------------------------------------------------------------------
# 提示：模型名区分大小写，请照抄。MINIMAX_GROUP_ID 属于旧版接口，当前不需要。
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_VIDEO_RESOLUTION=768P
MINIMAX_VIDEO_POLL_SECONDS=180
MINIMAX_VIDEO_POLL_INTERVAL=5

# -----------------------------------------------------------------------------
# [可选] 视频：火山方舟 / Seedance
# -----------------------------------------------------------------------------
# 注意：曾经的 Seedance 2.5 猜测 ID 在默认项目下未开通，务必填控制台里真实存在的 ID。
# ARK_API_KEY 会被自动映射为 VOLC_API_KEY / VOLC_IMAGE_MODEL / VOLC_VIDEO_MODEL。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
VOLC_VIDEO_RESOLUTION=720p
VOLC_VIDEO_POLL_SECONDS=180
# 仅当镜头模式为 auto 时，置 true 才会把 auto 解析为 keyframes（首尾帧）模式。
# 首尾帧路径尚未做过真实 Provider 验收，见排期说明。
VOLC_VIDEO_USE_KEYFRAMES=false
VOLC_VIDEO_API_KEY=
VOLC_IMAGE_API_KEY=
VOLC_IMAGE_MODEL=
VOLC_IMAGE_SIZE=1024x576

# -----------------------------------------------------------------------------
# [可选] 视频：阿里云百炼 / Wan
# -----------------------------------------------------------------------------
DASHSCOPE_API_KEY=
DASHSCOPE_API_HOST=https://your-workspace.cn-beijing.maas.aliyuncs.com
DASHSCOPE_T2V_MODEL=wan2.7-t2v
DASHSCOPE_I2V_MODEL=wan2.7-i2v
DASHSCOPE_VIDEO_RESOLUTION=720P
DASHSCOPE_VIDEO_POLL_SECONDS=180
DASHSCOPE_VIDEO_POLL_INTERVAL=5

# -----------------------------------------------------------------------------
# [可选] 检索向量：embedding provider（默认零费用本地 hash）
# -----------------------------------------------------------------------------
# hash      —— 字符二元组哈希，384 维。零费用、零外部依赖、离线可用。
#              它**不是语义模型**：同义、改写、指代一概召不回。默认值。
# dashscope —— 阿里云百炼 text-embedding-v4（OpenAI 兼容 /embeddings），默认 1024 维。
#              同义/改写可召回，代价是每次索引都要走网络（并计费，¥0.0005/千 token）。
#
# ★ 两种 provider 的向量**维度不同**，因此各自使用独立的 Chroma collection
#   （hash → visioncraft_memory，语义 → visioncraft_memory_sem_<model>）。
#   **切换后必须重建索引**，否则新 collection 是空的、检索会突然全空；
#   真发生时后端会打一条 warning 指明原因。
# ★ 远端失败（缺 key / 超时 / 余额不足）会在**进程内降级**回 hash 并记 warning，
#   索引与查询都改用降级后的 collection —— 工作流不会因为 embedding 挂掉而中断。
# ★ 零费用回归（tools/run_no_cost_regression.py）会把 EMBEDDING_PROVIDER 钉成 hash：
#   否则一改这里的值，那轮"零费用"回归就会开始花钱。
# ★ 实测收益（tools/eval_results.md，131 块 / 16 例标注 / **产品口径 k=2**）：
#     默认 hash            recall@2 = 0.8750
#     dashscope 语义       recall@2 = 0.9375（改写类 0.75 → 0.88，向量单路 0.0625 → 0.6875）
#   即语义的净收益是 **+0.0625**，代价是每次索引走网络（全量重建约 ¥0.03–0.05）并多一个
#   外部依赖。**默认仍是 hash**：离线、确定性、零费用。要更好的召回再打开这一档。
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024

# 混合排序权重（字面重合分 / 向量分）。留空则用 0.8 / 0.2 —— **两个 provider 同一套**。
# ★ 为什么语义档不改权重（实测结论，别凭直觉改回去）：0.3/0.7 会让 recall@2 从
#   0.9375 掉到 0.8125。向量一旦占主导，会把字面完全命中的块挤出 top-2。
#   语义该补的是"字面答不出的"（改写类 0.75→0.88），不是推翻字面已经答对的。
#   对照数据见 tmp/_fusion_lab.py 与 tools/eval_results.md。
HYBRID_LEXICAL_WEIGHT=
HYBRID_VECTOR_WEIGHT=

# -----------------------------------------------------------------------------
# [可选] 视频与图像：SiliconFlow
# -----------------------------------------------------------------------------
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2
SILICONFLOW_IMAGE_MODEL=Qwen/Qwen-Image
SILICONFLOW_IMAGE_SIZE=1024x576
SILICONFLOW_VIDEO_MODEL=Wan-AI/Wan2.2-T2V-A14B
SILICONFLOW_VIDEO_SIZE=1280x720
SILICONFLOW_VIDEO_POLL_SECONDS=180

# -----------------------------------------------------------------------------
# [遗留] 当前代码不读取
# -----------------------------------------------------------------------------
# 以下键在仓库内没有任何读取点，保留仅为与旧配置兼容。
# 其中 LANGCHAIN_* 例外：它们由 langchain 库自身读取，不属于本项目代码。
# VISIONCRAFT_ENV / VISIONCRAFT_PROVIDER_MODE 曾用于切换 live/mock，
# 现在真实调用的开关是上面的 VISIONCRAFT_ALLOW_LIVE_*，这两个键已无作用。
VISIONCRAFT_ENV=local
VISIONCRAFT_PROVIDER_MODE=mock
DOUBAO_LLM_ENDPOINT=
DOUBAO_TTS_ENDPOINT=
DOUBAO_IMAGE_ENDPOINT=
DOUBAO_VIDEO_ENDPOINT=
SEEDANCE_V2_ENDPOINT=
SEEDREAM_API_KEY=
SEEDANCE_API_KEY=
BAILIAN_API_KEY=
MINIMAX_GROUP_ID=
TAVILY_API_KEY=
ZHIPU_API_KEY=
NVIDIA_API_KEY=

# [遗留-第三方] langchain 会读取这些值，非本项目代码使用
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=VisionCraft
