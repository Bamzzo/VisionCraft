VISIONCRAFT_ENV=local

# mock: keep local fallback paths available for UI/workflow debugging.
# live: prefer configured remote model providers when keys and endpoints are available.
VISIONCRAFT_PROVIDER_MODE=mock
VISIONCRAFT_IMAGE_PROVIDER=siliconflow
VISIONCRAFT_VIDEO_PROVIDER=siliconflow

# Story planning LLM
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2

# Pydantic repair attempts for live story-plan JSON.
# Total attempts = 1 initial call + PLAN_VALIDATION_MAX_RETRIES.
PLAN_VALIDATION_MAX_RETRIES=2

# Image / video generation
SILICONFLOW_IMAGE_MODEL=Qwen/Qwen-Image
SILICONFLOW_IMAGE_SIZE=1024x576
SILICONFLOW_VIDEO_MODEL=Wan-AI/Wan2.2-T2V-A14B
SILICONFLOW_VIDEO_SIZE=1280x720
SILICONFLOW_VIDEO_POLL_SECONDS=180

# Embedding / retrieval
# EMBEDDING_PROVIDER: hash keeps the zero-dependency local fallback; siliconflow uses /embeddings.
# When using siliconflow, HYBRID_LEXICAL_WEIGHT=0.3 and HYBRID_VECTOR_WEIGHT=0.7 are usually better.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
HYBRID_LEXICAL_WEIGHT=0.8
HYBRID_VECTOR_WEIGHT=0.2

ZHIPU_API_KEY=
VOLC_API_KEY=
VOLC_IMAGE_API_KEY=
VOLC_VIDEO_API_KEY=
DOUBAO_LLM_ENDPOINT=
DOUBAO_TTS_ENDPOINT=
DOUBAO_IMAGE_ENDPOINT=
DOUBAO_VIDEO_ENDPOINT=
SEEDANCE_V2_ENDPOINT=
SEEDREAM_API_KEY=
SEEDANCE_API_KEY=
BAILIAN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
TAVILY_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=VisionCraft
NVIDIA_API_KEY=
